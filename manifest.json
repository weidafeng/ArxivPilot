{
  "manifest_version": 3,
  "name": "ArXiv Reader",
  "description": "一键打开 arxiv 论文的多个辅助阅读页面",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["tabs", "tabGroups"],
  "host_permissions": ["https://arxiv.org/*"]
}
